      "title": "\u0648\u0632\u064a\u0631 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0621: \u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0634\u0628\u0643\u0629 \u0627\u0644\u0642\u0648\u0645\u064a\u0629 \u0645\u0633\u062a\u0645\u0631 \u0648\u0632\u064a\u0627\u062f\u0629 \u0639\u062f\u062f \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u064a\u0646 \u0625\u0644\u0649 47.14 \u0645\u0644\u064a\u0648\u0646",
      "description": "\u0623\u0643\u062f \u0648\u0632\u064a\u0631 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0621 \u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0634\u0628\u0643\u0629 \u0627\u0644\u0642\u0648\u0645\u064a\u0629\u060c \u0648\u0643\u0634\u0641 \u0639\u0646 \u0627\u0633\u062a\u0647\u062f\u0627\u0641 \u0632\u064a\u0627\u062f\u0629 \u0639\u062f\u062f \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u064a\u0646 \u0625\u0644\u0649 47.14 \u0645\u0644\u064a\u0648\u0646 \u062e\u0644\u0627\u0644 \u0645\u0648\u0627\u0632\u0646\u0629 2026/2027.",
      "content": "\u0645\u0635\u0631 \u0627\u0644\u0642\u0627\u0647\u0631\u0629 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0621 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0621 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0634\u0628\u0643\u0629 \u0627\u0644\u0642\u0648\u0645\u064a\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u062a\u062c\u062f\u062f\u0629",
      "keywords": "\u0637\u0627\u0642\u0629,\u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0621,\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0621,\u0627\u0644\u0642\u0627\u0628\u0636\u0629 \u0644\u0643\u0647\u0631\u0628\u0627\u0621 \u0645\u0635\u0631,\u0627\u0644\u0642\u0627\u0628\u0636\u0629 \u0644\u0644\u0643\u0647\u0631\u0628\u0627\u0621",
